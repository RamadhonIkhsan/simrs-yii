    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost/OTHER/SIMRS/simrs-yii/web",
            "type": "string",
            "description": "Ganti dengan domain local Anda (misal http://simrs-yii.test atau http://localhost:8080)"
        },
        {
            "key": "token",
            "value": "",
            "type": "string",
            "description": "Token JWT otomatis terisi saat menjalankan request POST Login"
        },
        {
            "key": "user_id",
            "value": "2",
            "type": "string",
            "description": "ID user untuk request GET/PUT/DELETE by ID (otomatis terupdate saat Create User)"
        },
        {
            "key": "poli_id",
            "value": "2",
            "type": "string",
            "description": "ID Poli untuk GET/PUT/DELETE by ID"
        },
        {
            "key": "doctor_id",
            "value": "2",
            "type": "string",
            "description": "ID Doctor untuk GET/PUT/DELETE by ID"
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Login (POST /login)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var res = pm.response.json();",
                                    "if (res.rc === 200 && res.data && res.data.token) {",
                                    "    pm.collectionVariables.set(\"token\", res.data.token);",
                                    "    console.log(\"Token berhasil disimpan ke variabel: \", res.data.token);",
                                    "    pm.test(\"Login berhasil & token didapatkan\", function () {",
                                    "        pm.expect(res.rc).to.eql(200);",
                                    "        pm.expect(res.data.token).to.be.a('string');",
                                    "    });",
                                    "} else {",
                                    "    pm.test(\"Login gagal\", function () {",
                                    "        pm.expect(res.rc).to.eql(200);",
                                    "    });",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "username",
                                    "value": "admin",
                                    "type": "text"
                                },
                                {
                                    "key": "password",
                                    "value": "admin",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "login"
                            ]
                        },
                        "description": "Login menggunakan formData `username` dan `password`.\nJika sukses, token akan otomatis tersimpan di collection variable `token`."
                    },
                    "response": []
                }
            ]
        },
